{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rneves-website",
  "compatibility_date": "2026-05-25",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
}
